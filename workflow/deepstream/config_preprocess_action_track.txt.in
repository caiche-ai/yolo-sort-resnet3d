[property]
enable=1
target-unique-ids=2
operate-on-gie-id=1
process-on-frame=0
unique-id=5
gpu-id=0
network-input-order=2
network-input-shape=4;3;30;200;200
network-color-format=0
tensor-data-type=0
tensor-name=normalized_clips
processing-width=200
processing-height=200
scaling-pool-memory-type=0
scaling-pool-compute-hw=1
scaling-filter=1
scaling-buf-pool-size=12
tensor-buf-pool-size=12
custom-lib-path=@SEQUENCE_LIBRARY@
custom-tensor-preparation-function=CustomSequenceTensorPreparation

[user-configs]
channel-scale-factors=0.014167516717669726;0.014454731394953853;0.014327981832119039
channel-mean-offsets=110.7975;103.3005;96.2625
stride=30
subsample=@ACTION_SUBSAMPLE@

[group-0]
src-ids=0
operate-on-class-ids=0
process-on-all-objects=0
# Keep object metadata attached so the custom library can use NvSORT object_id.
# This ROI entry initialises the source-to-group map required by DeepStream 6.2.
roi-params-src-0=0;0;1;1
input-object-min-width=16
input-object-min-height=32
