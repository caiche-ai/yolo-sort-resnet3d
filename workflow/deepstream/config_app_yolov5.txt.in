[application]
enable-perf-measurement=1
perf-measurement-interval-sec=1
gie-kitti-output-dir=@METADATA_DIR@

[tiled-display]
enable=0

[source0]
enable=1
type=3
uri=@INPUT_URI@
num-sources=1
gpu-id=0
cudadec-memtype=0

[sink0]
enable=1
type=3
container=1
codec=1
enc-type=0
sync=0
bitrate=10000000
profile=0
output-file=@OUTPUT_PATH@
source-id=0

[osd]
enable=1
gpu-id=0
process-mode=1
border-width=2
text-size=16
text-color=1;1;1;1
text-bg-color=0.3;0.3;0.3;1
font=Sans
show-clock=0
nvbuf-memory-type=0

[streammux]
gpu-id=0
live-source=0
batch-size=1
batched-push-timeout=40000
width=@MUX_WIDTH@
height=@MUX_HEIGHT@
enable-padding=0
nvbuf-memory-type=0

[primary-gie]
enable=1
gpu-id=0
batch-size=1
interval=0
gie-unique-id=1
nvbuf-memory-type=0
config-file=@INFER_CONFIG@

[tests]
file-loop=0
